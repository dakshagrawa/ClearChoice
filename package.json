{
  "name": "clearchoice",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "test": "vitest",
    "build": "tsc --noEmit && node scripts/build-manifest.mjs --release --output .release-manifest.json && npm run build:assets && npm run verify:package",
    "build:assets": "vite build && CLEARCHOICE_CONTENT_BUILD=1 vite build",
    "serve:fixtures": "node scripts/serve-fixtures.mjs",
    "verify:package": "node scripts/verify-package.mjs --dist dist",
    "verify:archive": "node scripts/verify-package.mjs --zip ClearChoice-v0.2.0-unpacked.zip",
    "package:unpacked": "npm run build && node scripts/package-unpacked.mjs",
    "e2e": "playwright test",
    "check:beta": "node scripts/check-beta.mjs",
    "manual:active-tab-qa": "node scripts/manual-active-tab-qa.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.1",
    "@types/chrome": "0.0.327",
    "@types/node": "22.18.12",
    "eslint": "9.39.1",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.1.12",
    "vitest": "5.0.1"
  }
}
