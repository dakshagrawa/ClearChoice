{
  "manifest_version": 3,
  "name": "ClearChoice",
  "version": "0.2.0",
  "description": "A private-beta Chromium extension popup for checkout analysis.",
  "action": {
    "default_popup": "popup/index.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": []
}
