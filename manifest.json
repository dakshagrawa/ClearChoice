{
  "manifest_version": 3,
  "name": "ClearChoice",
  "version": "1.0.0",
  "version_name": "1.0.0-rc.1",
  "description": "A local Linux Chromium extension for checkout analysis and subscription tracking.",
  "action": {
    "default_popup": "popup/index.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "worker.js" }
}
